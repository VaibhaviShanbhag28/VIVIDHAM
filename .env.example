# ─────────────────────────────────────────────────────────────
# VIVIDHUM JEWELLERY — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All values below are placeholders.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://vividhum_app:CHANGE_ME@localhost:5432/vividhum?schema=public"

# Separate database used ONLY by `npm test` integration tests (optional; its data is wiped on every run)
# TEST_DATABASE_URL="postgresql://vividhum_app:CHANGE_ME@localhost:5432/vividhum_test?schema=public"

# Public base URL of the site (used for canonical links, sitemap and WhatsApp product links)
APP_URL="http://localhost:3000"

# Admin session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to true ONLY when running behind a trusted reverse proxy / platform (Vercel, Nginx, Cloudflare)
# that sets X-Forwarded-For. Enables per-visitor rate limiting.
TRUST_PROXY=false

# ── Image & file uploads ──────────────────────────────────────
# "local"      — files are stored on this server's disk in UPLOAD_DIR (development / single server with persistent disk)
# "cloudinary" — recommended for production
UPLOAD_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB=8
# Local storage is refused in production unless explicitly allowed (requires a persistent disk + backups)
ALLOW_LOCAL_UPLOADS_IN_PRODUCTION=false

# Cloudinary (required when UPLOAD_DRIVER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="vividhum"

# ── Optional privacy-friendly analytics (disabled when empty) ──
# e.g. a self-hosted Plausible / Umami script URL. Loaded only if set; allowed in the CSP automatically.
NEXT_PUBLIC_ANALYTICS_SRC=""
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
