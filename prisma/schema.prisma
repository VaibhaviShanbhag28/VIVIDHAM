// VIVIDHUM JEWELLERY — database schema (PostgreSQL)
// Monetary values use DECIMAL columns; never floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Admin & auth ───────────────────────────────

enum AdminRole {
  OWNER
  ADMIN
}

model AdminUser {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  passwordHash      String
  role              AdminRole      @default(ADMIN)
  isActive          Boolean        @default(true)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          AdminSession[]
}

/// Server-side sessions. Only a SHA-256 hash of the session token is stored;
/// the raw token lives exclusively in an HTTP-only cookie.
model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  userAgent   String?   @db.VarChar(300)
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

/// Fixed-window rate-limit buckets (login attempts, public forms). Shared across
/// server instances because it lives in the database.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ─────────────────────────────── Catalogue ───────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Availability {
  IN_STOCK
  MADE_TO_ORDER
  ON_REQUEST
  SOLD_OUT
}

enum StorageProvider {
  STATIC
  LOCAL
  CLOUDINARY
}

model Category {
  id          String            @id @default(cuid())
  name        String            @db.VarChar(80)
  slug        String            @unique @db.VarChar(100)
  description String?           @db.VarChar(500)
  imageUrl    String?
  position    Int               @default(0)
  isActive    Boolean           @default(true)
  showInNav   Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductCategory[]

  @@index([isActive, position])
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique @db.VarChar(160)
  sku              String        @unique @db.VarChar(64)
  name             String        @db.VarChar(160)
  shortDescription String?       @db.VarChar(300)
  description      String        @db.Text
  status           ProductStatus @default(DRAFT)
  availability     Availability  @default(IN_STOCK)
  stockQuantity    Int?

  /// Regular selling price in INR. NULL means "price on request".
  price            Decimal?      @db.Decimal(12, 2)
  /// Optional discounted price; must be lower than `price`.
  salePrice        Decimal?      @db.Decimal(12, 2)
  /// Denormalised `salePrice ?? price`, maintained by the product service for sorting / filtering.
  effectivePrice   Decimal?      @db.Decimal(12, 2)
  currency         String        @default("INR") @db.VarChar(3)

  jewelleryType    String?       @db.VarChar(80)
  material         String?       @db.VarChar(80)
  metalPurity      String?       @db.VarChar(40)
  metalColour      String?       @db.VarChar(40)
  hallmarkDetails  String?       @db.VarChar(200)
  grossWeightGrams Decimal?      @db.Decimal(10, 3)
  netWeightGrams   Decimal?      @db.Decimal(10, 3)
  dimensions       String?       @db.VarChar(120)
  size             String?       @db.VarChar(80)
  otherDetails     String?       @db.Text
  careInstructions String?       @db.Text
  tags             String[]      @default([])

  isFeatured       Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  /// Sample / demonstration content — shown with a visible "Demo" badge and excluded from structured data.
  isDemo           Boolean       @default(false)

  seoTitle         String?       @db.VarChar(70)
  seoDescription   String?       @db.VarChar(160)

  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images           ProductImage[]
  categories       ProductCategory[]
  gemstones        ProductGemstone[]
  certifications   ProductCertification[]
  enquiries        Enquiry[]

  @@index([status, createdAt])
  @@index([status, effectivePrice])
  @@index([status, isFeatured])
  @@index([status, isNewArrival])
  @@index([jewelleryType])
  @@index([material])
  @@index([availability])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?
  provider   StorageProvider @default(LOCAL)
  alt        String?         @db.VarChar(200)
  width      Int?
  height     Int?
  position   Int             @default(0)
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([productId, position])
}

/// Gemstone details are only stored when supplied by the client — never inferred.
model ProductGemstone {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(60)
  colour      String?  @db.VarChar(60)
  cut         String?  @db.VarChar(60)
  shape       String?  @db.VarChar(60)
  clarity     String?  @db.VarChar(60)
  caratWeight Decimal? @db.Decimal(8, 3)
  count       Int?
  origin      String?  @db.VarChar(80)
  treatment   String?  @db.VarChar(120)
  position    Int      @default(0)

  @@index([productId])
  @@index([type])
}

model ProductCertification {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  issuer            String           @db.VarChar(120)
  certificateNumber String?          @db.VarChar(80)
  reportDate        DateTime?        @db.Date
  verificationUrl   String?
  fileUrl           String?
  fileKey           String?
  fileProvider      StorageProvider?
  fileType          String?          @db.VarChar(40)
  notes             String?          @db.VarChar(500)
  createdAt         DateTime         @default(now())

  @@index([productId])
}

// ─────────────────────────────── Enquiries ───────────────────────────────

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  CLOSED
}

enum EnquiryChannel {
  WEBSITE_FORM
  WHATSAPP_MANUAL
  PHONE_MANUAL
  IN_STORE_MANUAL
  OTHER_MANUAL
}

model Enquiry {
  id              String         @id @default(cuid())
  reference       String         @unique @db.VarChar(24)
  channel         EnquiryChannel @default(WEBSITE_FORM)
  status          EnquiryStatus  @default(NEW)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Product name / SKU / displayed price at the time of the enquiry.
  productSnapshot Json?
  quantity        Int?
  customerName    String?        @db.VarChar(120)
  email           String?        @db.VarChar(200)
  phone           String?        @db.VarChar(32)
  message         String?        @db.Text
  consentGiven    Boolean        @default(false)
  adminNotes      String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([productId])
}

// ─────────────────────────────── Site content ───────────────────────────────

/// Singleton row (id = "default") holding editable business settings.
model SiteSettings {
  id                  String   @id @default("default")
  businessName        String   @default("VIVIDHUM JEWELLERY") @db.VarChar(120)
  tagline             String?  @db.VarChar(200)
  logoUrl             String?
  brandStory          String?  @db.Text

  phone               String?  @db.VarChar(20)
  whatsappNumber      String?  @db.VarChar(20)
  email               String?  @db.VarChar(200)
  addressLine1        String?  @db.VarChar(200)
  addressLine2        String?  @db.VarChar(200)
  city                String?  @db.VarChar(80)
  state               String?  @db.VarChar(80)
  postalCode          String?  @db.VarChar(12)
  country             String?  @default("India") @db.VarChar(80)
  mapUrl              String?
  businessHours       String?  @db.Text

  instagramUrl        String?
  facebookUrl         String?
  youtubeUrl          String?
  pinterestUrl        String?

  announcementEnabled Boolean  @default(true)
  announcementText    String?  @db.VarChar(200)
  announcementLink    String?

  heroEyebrow         String?  @db.VarChar(80)
  heroTitle           String?  @db.VarChar(120)
  heroSubtitle        String?  @db.VarChar(300)
  heroCtaLabel        String?  @db.VarChar(40)
  heroCtaHref         String?  @db.VarChar(200)
  heroImageUrl        String?

  /// Array of { title, description } shown in the trust / service strip.
  trustHighlights     Json?
  footerText          String?  @db.VarChar(500)
  currencyCode        String   @default("INR") @db.VarChar(3)
  shippingInfo        String?  @db.Text
  returnsSummary      String?  @db.Text

  updatedAt           DateTime @updatedAt
}

/// Editable long-form pages: policies and the About page.
/// `isApproved = false` renders a visible "awaiting client approval" notice.
model ContentPage {
  id         String   @id @default(cuid())
  slug       String   @unique @db.VarChar(60)
  title      String   @db.VarChar(120)
  summary    String?  @db.VarChar(300)
  body       String   @db.Text
  isApproved Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}
